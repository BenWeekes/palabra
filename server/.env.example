# Palabra Backend Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Agora Credentials (must match frontend config.json)
# =============================================================================
APP_ID=your_agora_app_id
APP_CERTIFICATE=your_agora_app_certificate
CUSTOMER_ID=your_agora_customer_id
CUSTOMER_CERTIFICATE=your_agora_customer_certificate

# =============================================================================
# Palabra Translation API
# =============================================================================
PALABRA_CLIENT_ID=your_palabra_client_id
PALABRA_CLIENT_SECRET=your_palabra_client_secret

# Session timeout in minutes (auto-stop sessions after this duration)
PALABRA_SESSION_TIMEOUT_MINUTES=10

# Idle timeout in seconds (auto-stop if no audio activity)
PALABRA_IDLE_TIMEOUT_SECONDS=60

# =============================================================================
# Anam Avatar Configuration
# =============================================================================
# Set to true to enable Anam avatar rendering
ENABLE_ANAM=true

# Anam API credentials (required if ENABLE_ANAM=true)
ANAM_API_KEY=your_anam_api_key_base64
ANAM_BASE_URL=https://api.anam.ai/v1
ANAM_AVATAR_ID=your_avatar_uuid
ANAM_QUALITY=high
ANAM_VIDEO_ENCODING=H264

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=appbuilder
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=appbuilder

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8080
SCHEME=https
ALLOWED_ORIGIN=https://yourdomain.com:7000

# =============================================================================
# Optional Configuration
# =============================================================================
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_ACCESS_SECRET=
CLIENT_ID=
CLIENT_SECRET=
PSTN_USERNAME=
PSTN_PASSWORD=
PSTN_NUMBER=

# Monitoring
ENABLE_NEWRELIC_MONITORING=false

# Migration (set to false for stub mode)
RUN_MIGRATION=true
